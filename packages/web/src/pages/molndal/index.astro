---
import DecisionCard from '../../../../ui/src/components/cards/DecisionCard.astro'
import Chamber from '../../../../ui/src/components/charts/Chamber.astro'
import Gauge from '../../../../ui/src/components/charts/Gauge.astro'
import Heatmap from '../../../../ui/src/components/charts/Heatmap.astro'
import HorizontalBar from '../../../../ui/src/components/charts/HorizontalBar.astro'
import ProgressBar from '../../../../ui/src/components/charts/ProgressBar.astro'
import Button from '../../../../ui/src/components/core/Button.astro'
import Card from '../../../../ui/src/components/core/Card.astro'
import DataTable from '../../../../ui/src/components/core/DataTable.astro'
import Icon from '../../../../ui/src/components/core/Icon.astro'
import { generatePartyTagHTML } from '../../../../ui/src/components/party-tag/index.ts'
import {
  type Politiker,
  getAllBeslut,
  getBudget,
  getMandat,
  getMetrics,
  getMöten,
  getPolitiker,
  getSammantraden,
} from '../../data/api'
import Kommun from '../../layouts/Kommun.astro'

const KOMMUN = 'molndal'
const TROMAN = 'https://molndal.tromanpublik.se'

const [politiker, mandat, sammanträden, budget, metrics, möten, allaBeslut] = await Promise.all([
  getPolitiker(KOMMUN),
  getMandat(KOMMUN),
  getSammantraden(KOMMUN),
  getBudget(KOMMUN),
  getMetrics(KOMMUN),
  getMöten(KOMMUN),
  getAllBeslut(KOMMUN),
])

// --- Mandatperioden 2022–2026 ur protokollen (parse-protokoll-molndal.ts) ---
const kfMöten = möten.filter((m: any) => m.label?.includes('KF'))
const ksMöten = möten.filter((m: any) => m.label?.includes('KS'))
const kfBeslut = allaBeslut.filter((b: any) => b.organ === 'KF')
const status = (b: any) =>
  b.beslut === 'bordläggning' ? 'bordlagd' : b.beslut === 'beslut' ? 'antecknad' : b.beslut
const beslutKort = (b: any) => ({
  titel: b.rubrik.replace(/^§ \d+ /, ''),
  datum: b.datum,
  status: status(b),
  paragraf: `${b.organ} ${b.paragraf}`,
  ja: b.votering?.ja,
  nej: b.votering?.nej,
  avstar: b.votering?.avstår,
  namnupprop: b.namnupprop,
  url: `/molndal/beslut/${encodeURIComponent(b.id)}`,
})
const senasteBeslut = kfBeslut
  .filter((b: any) => b.beslut !== 'beslut')
  .sort((a: any, b: any) => b.datum.localeCompare(a.datum))
  .slice(0, 6)
  .map(beslutKort)
// Jämnast voteringar = de mest omstridda besluten
const omstridda = allaBeslut
  .filter((b: any) => b.votering)
  .sort(
    (a: any, b: any) =>
      Math.abs(a.votering.ja - a.votering.nej) - Math.abs(b.votering.ja - b.votering.nej),
  )
  .slice(0, 4)
  .map(beslutKort)

// Personlig närvaro: ordinarie ledamöter på plats per KF-möte (parse-protokoll-molndal.ts)
const närvaroPunkter = kfMöten.map((m: any) => m.ordinarieNärvarande).filter((v: any) => v != null)
const närvaroSnitt = närvaroPunkter.length
  ? Math.round(
      (närvaroPunkter.reduce((a: number, b: number) => a + b, 0) / närvaroPunkter.length) * 10,
    ) / 10
  : null
const närvaroProcent = närvaroSnitt === null ? null : Math.round((närvaroSnitt / 61) * 100)

// Motionsutfall: "Svar på motion …"-paragrafer i KF
// Bordlagda räknas inte — de är inte avgjorda än (kommer tillbaka på senare möte)
const motionsSvar = kfBeslut.filter(
  (b: any) => /^(§ \d+ )?Svar på motion/i.test(b.rubrik) && b.beslut !== 'bordläggning',
)
const bifallnaMotioner = motionsSvar.filter((b: any) => b.beslut === 'bifall').length
const motioner = {
  totalt: motionsSvar.length,
  bifall: bifallnaMotioner,
  procent: motionsSvar.length ? Math.round((bifallnaMotioner / motionsSvar.length) * 100) : 0,
}

const riceEntries = Object.entries(metrics.riceIndex || {}).sort(
  ([, a]: any, [, b]: any) => b - a,
) as [string, number][]
const { partier: överensPartier, matris: överensMatris } = metrics.röstÖverensstämmelse || {
  partier: [],
  matris: [],
}
const budgetBars = budget.nämnder
  .filter((n: any) => n.kommunbidragMnkr)
  .sort((a: any, b: any) => b.kommunbidragMnkr - a.kommunbidragMnkr)
  .map((n: any) => ({ label: n.namn, value: n.kommunbidragMnkr, subtitle: `${n.andelProcent}%` }))

// Partier med egen färgtoken; övriga (MÖ, partilösa) visas som "-" / --parti-ovriga
const FÄRGADE = new Set(['S', 'M', 'SD', 'C', 'V', 'KD', 'MP', 'L', 'D'])
const partikod = (parti: string) => (FÄRGADE.has(parti) ? parti : '-')
const färg = (parti: string) =>
  FÄRGADE.has(parti) ? `var(--parti-${parti.toLowerCase()})` : 'var(--parti-ovriga)'

// Presidiet (ordförande/vice) är ledamöter men har den rollen i registret
const ÄR_LEDAMOT = /^(Ledamot|Ordförande|(\d:e )?vice ordförande)\b/i
const ledamöterI = (organ: string) =>
  politiker.filter((p) =>
    (p.uppdrag || []).some((u) => u.organisation === organ && ÄR_LEDAMOT.test(u.roll)),
  )
const rollI = (p: Politiker, organ: string) =>
  (p.uppdrag || []).find((u) => u.organisation === organ)?.roll ?? ''

// Partiordning: mandat i KF 2022–2026, störst först
const kf = ledamöterI('Kommunfullmäktige')
const kfPerParti = new Map<string, number>()
for (const p of kf) kfPerParti.set(p.parti, (kfPerParti.get(p.parti) || 0) + 1)
const partiRank = new Map(
  [...kfPerParti].sort((a, b) => b[1] - a[1]).map(([parti], i) => [parti, i]),
)
const överensOrdning = [...överensPartier].sort(
  (a: string, b: string) => (partiRank.get(a) ?? 99) - (partiRank.get(b) ?? 99),
)
const överensIndex = new Map(överensPartier.map((p: string, i: number) => [p, i]))
const överensMatrisSorterad = överensOrdning.map((a) =>
  överensOrdning.map((b) => överensMatris[överensIndex.get(a)!][överensIndex.get(b)!]),
)
const partiFärger = Object.fromEntries(överensOrdning.map((p) => [p, färg(p)]))

const efterParti = (a: Politiker, b: Politiker) =>
  (partiRank.get(a.parti) ?? 99) - (partiRank.get(b.parti) ?? 99) ||
  a.namn.localeCompare(b.namn, 'sv')

const seats = [...kf].sort(efterParti).map((p, i) => ({
  nummer: i + 1,
  politikerId: p.id,
  namn: p.namn,
  parti: partikod(p.parti) as any,
}))

const ks = ledamöterI('Kommunstyrelsen').sort(efterParti)
const ksPresidium = ks.filter((p) => !/^Ledamot\b/i.test(rollI(p, 'Kommunstyrelsen')))

// Mandatperiod 2022–2026 (kommunallagen 5 kap. 7 §: 15 oktober valåret)
const mandatStart = new Date('2022-10-15')
const mandatSlut = new Date('2026-10-15')
const mandatProcent = Math.min(
  100,
  ((Date.now() - mandatStart.getTime()) / (mandatSlut.getTime() - mandatStart.getTime())) * 100,
)

// Val 2026 — Valmyndighetens slutliga resultat
const räkning = mandat[0]?.räkningstillfälle
const valdeltagande = mandat[0]?.valdeltagande
const mandatBars = [...mandat]
  .sort((a, b) => b.antalMandat - a.antalMandat)
  .map((m) => {
    const diff =
      m.antalMandatFöregåendeVal == null ? null : m.antalMandat - m.antalMandatFöregåendeVal
    return {
      label: m.partiNamn,
      value: m.antalMandat,
      color: färg(m.parti),
      subtitle: diff == null ? 'nytt' : diff === 0 ? '±0' : diff > 0 ? `+${diff}` : String(diff),
    }
  })
const totalMandat = mandat.reduce((s, m) => s + m.antalMandat, 0)

// Organ: antal förtroendevalda per nämnd/bolag/förbund (från uppdragen)
const perOrgan = new Map<string, { id: string; antal: number }>()
for (const p of politiker) {
  for (const u of p.uppdrag || []) {
    const o = perOrgan.get(u.organisation) || { id: (u as any).organisationId, antal: 0 }
    o.antal++
    perOrgan.set(u.organisation, o)
  }
}
const nämnder = [...perOrgan]
  .filter(([namn]) => /nämnd/i.test(namn) && !/utskott|^nämndemän/i.test(namn))
  .sort((a, b) => a[0].localeCompare(b[0], 'sv'))

// Sammanträden med publicerade handlingar (länk till Mölndals webbdiarium)
const idag = new Date().toISOString().slice(0, 10)
const senaste = (organ: string) => sammanträden.find((m) => m.organ === organ && m.datum <= idag)
const senasteKF = senaste('Kommunfullmäktige')
const senasteKS = senaste('Kommunstyrelsen')
const mötesrader = sammanträden.map((m) => ({
  datum: m.datum,
  organ: m.organ,
  handlingar: 'Kallelse/protokoll',
  _handlingar_html: `<a href="${m.url}" class="underline hover:text-(--color-primary)" rel="noopener">Webbdiariet ↗</a>`,
}))

const person = (p: Politiker, roll?: string) =>
  `${generatePartyTagHTML({ parti: p.parti, size: 'sm' })} <a href="/molndal/politiker/${p.id}" class="hover:text-(--color-primary)">${p.namn}</a>${roll ? ` <span class="text-(--color-text-muted)">— ${roll}</span>` : ''}`
---

<Kommun title="Mölndal" kommun={KOMMUN} kommunNamn="Mölndal">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-2">Mölndal</h1>
    <p class="text-(--color-text-muted) mb-4">
      Kommunfullmäktige — {kf.length} ledamöter som beslutar för dig. Från 15 oktober 2026 tar den nya
      fullmäktigeförsamlingen över.
    </p>
    <ProgressBar
      label="Mandatperiod 2022–2026"
      value={mandatProcent}
      valueLabel={`${Math.round(mandatProcent)}% avklarad`}
      class="max-w-sm"
    />
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-4">Kommunfullmäktige 2022–2026</h2>
    <div class="mx-auto p-6 rounded-xl bg-(--color-surface) border border-(--color-border)">
      <Chamber seats={seats} mode="overview" />
    </div>
    <div class="flex gap-1.5 flex-wrap mt-4">
      {[...kfPerParti].sort((a, b) => b[1] - a[1]).map(([parti, antal]) => (
        <span class="chip" set:html={`${generatePartyTagHTML({ parti, size: 'sm' })} ${antal}`} />
      ))}
    </div>
  </section>

  <!-- KPI-rad, som Göteborgs översikt -->
  <section class="mb-12">
    <div class="grid gap-4 grid-cols-[repeat(auto-fit,minmax(180px,1fr))]">
      <Card title="Politiker" titleSize="sm">
        <div class="font-mono text-[2.5rem] font-bold leading-none">{politiker.length}</div>
      </Card>
      <Card title="Beslut (paragrafer)" titleSize="sm">
        <div class="font-mono text-[2.5rem] font-bold leading-none">{allaBeslut.length}</div>
        <p class="text-xs text-(--color-text-muted) mt-1">{kfBeslut.length} i KF</p>
      </Card>
      <Card title="Möten" titleSize="sm">
        <div class="font-mono text-[2.5rem] font-bold leading-none">{möten.length}</div>
        <p class="text-xs text-(--color-text-muted) mt-1">{kfMöten.length} KF · {ksMöten.length} KS</p>
      </Card>
      <Card title="Voteringar" titleSize="sm">
        <div class="font-mono text-[2.5rem] font-bold leading-none">{metrics.konsensus.medVotering}</div>
        <p class="text-xs text-(--color-text-muted) mt-1">med namnupprop</p>
      </Card>
    </div>
  </section>

  <!-- Demokratisk hälsa -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-2">Demokratisk hälsa</h2>
    <p class="text-sm text-(--color-text-muted) mb-4">
      Mandatperioden 2022–2026 ur {kfMöten.length} KF- och {ksMöten.length} KS-protokoll —
      <a href="/molndal/kf" class="underline hover:text-(--color-primary)">alla beslut och sammanträden</a>.
      Debattmåtten (talartid, Gini) saknas: Mölndal publicerar inga yttrandeprotokoll.
    </p>
    <div class="grid gap-4 grid-cols-[repeat(auto-fit,minmax(220px,1fr))]">
      <Card title="Konsensus" subtitle="Ärenden utan votering" tooltip="Andel beslut som fattades utan formell omröstning — alla var överens. Över 85% kan tyda på att den verkliga debatten sker innan sammanträdet.">
        <div class="flex justify-center">
          <Gauge
            value={metrics.konsensus.konsensusgradProcent}
            unit="%"
            zones={[
              { from: 0, to: 85, color: 'var(--color-positive)' },
              { from: 85, to: 100, color: 'var(--color-warning)' },
            ]}
          />
        </div>
        {metrics.konsensus.konsensusgradProcent > 85 && (
          <div class="mt-2 text-xs font-semibold flex items-center gap-1 text-(--color-warning)">
            <Icon name="triangle-alert" size={14} />
            Hög — kan dölja brist på debatt
          </div>
        )}
      </Card>

      {närvaroProcent !== null && (
        <Card title="Personlig närvaro" subtitle={`Ordinarie KF-ledamöter på plats, snitt ${närvaroSnitt} av 61`} tooltip="Andel av de 61 valda ledamöterna som själva tjänstgjorde, i snitt per KF-sammanträde (enligt protokollens Beslutande-lista). Resten ersattes av ersättare.">
          <div class="flex justify-center">
            <Gauge
              value={närvaroProcent}
              unit="%"
              zones={[
                { from: 0, to: 80, color: 'var(--color-negative)' },
                { from: 80, to: 90, color: 'var(--color-warning)' },
                { from: 90, to: 100, color: 'var(--color-positive)' },
              ]}
            />
          </div>
        </Card>
      )}

      {motioner.totalt > 0 && (
        <Card title="Motioner som bifölls" subtitle={`${motioner.bifall} av ${motioner.totalt} avgjorda motioner i KF`} tooltip="Motioner är enskilda ledamöters förslag. Andelen som KF helt eller delvis bifaller visar hur mycket utrymme initiativ utanför styret får. Besvarade och avslagna räknas som ej bifallna." tooltipPosition="top-right">
          <div class="flex justify-center">
            <Gauge
              value={motioner.procent}
              unit="%"
              zones={[
                { from: 0, to: 10, color: 'var(--color-warning)' },
                { from: 10, to: 100, color: 'var(--color-positive)' },
              ]}
            />
          </div>
        </Card>
      )}
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="bg-(--color-surface) border border-(--color-border) rounded-lg p-4">
        <h3 class="font-bold mb-3">Parti-sammanhållning (Rice Index)</h3>
        <p class="text-xs text-(--color-text-muted) mb-3">1.0 = alla röstar lika, 0.5 = splittrat. Källa: Rice (1924)</p>
        <HorizontalBar bars={riceEntries.map(([parti, rice]) => ({ label: parti === '-' ? 'Partilösa' : parti, value: rice, color: färg(parti) }))} max={1} />
      </div>
      {överensOrdning.length > 1 && (
        <div class="bg-(--color-surface) border border-(--color-border) rounded-lg p-4">
          <h3 class="font-bold mb-3">Röstöverensstämmelse mellan partier</h3>
          <p class="text-xs text-(--color-text-muted) mb-3">Andel voteringar där partiernas majoritet röstade lika — visar samarbetsmönster.</p>
          <Heatmap labels={överensOrdning} matrix={överensMatrisSorterad} colors={partiFärger} unit="överensstämmelse" />
        </div>
      )}
    </div>

    {omstridda.length > 0 && (
      <div class="mt-6">
        <h3 class="font-bold mb-3">Jämnaste voteringarna</h3>
        <div class="grid gap-4 md:grid-cols-2">
          {omstridda.map((b) => <DecisionCard {...b} />)}
        </div>
      </div>
    )}

    <div class="mt-6">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-bold">Senaste KF-beslut</h3>
        <Button variant="ghost" href="/molndal/kf/beslut">Alla beslut →</Button>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {senasteBeslut.map((b) => <DecisionCard {...b} />)}
      </div>
    </div>
  </section>

  <section class="mb-12 grid gap-4 grid-cols-[repeat(auto-fit,minmax(300px,1fr))]">
    <Card title={`Valet 2026 — ${räkning === 'slutlig' ? 'slutligt resultat' : 'preliminärt resultat'}`} subtitle={`Valdeltagande ${valdeltagande ?? '–'} · ${totalMandat} mandat`}>
      <HorizontalBar bars={mandatBars} labelWidth="14rem" />
      <div class="mt-4">
        <Button variant="secondary" href="/molndal/mandatperiod-2026">Nya fullmäktige 2026–2030 →</Button>
      </div>
    </Card>

    <Card title="Kommunstyrelsen" subtitle={`${ks.length} ledamöter`}>
      <ul class="flex flex-col gap-1.5 text-sm">
        {ksPresidium.map((p) => <li set:html={person(p, rollI(p, 'Kommunstyrelsen'))} />)}
        {ks.filter((p) => !ksPresidium.includes(p)).map((p) => <li set:html={person(p)} />)}
      </ul>
    </Card>
  </section>

  <section class="mb-12">
    <Card title={`Budget ${budget.år}`} subtitle={`Kommunbidrag per nämnd — totalt ${budget.totalMnkr.toLocaleString('sv-SE')} mnkr`}>
      <HorizontalBar bars={budgetBars} unit="mnkr" labelWidth="16rem" />
      <div class="mt-4 flex gap-3 flex-wrap">
        <Button variant="secondary" href="/molndal/budget">Budget och utfall →</Button>
        <Button variant="secondary" href="/molndal/trender">Trender (Kolada) →</Button>
      </div>
    </Card>
  </section>

  <section class="mb-12 grid gap-4 grid-cols-[repeat(auto-fit,minmax(300px,1fr))]">
    <Card title="Senaste sammanträden" subtitle="Med publicerade handlingar">
      <ul class="flex flex-col gap-2 text-sm">
        {senasteKF && <li>Kommunfullmäktige — <a href={senasteKF.url} class="underline hover:text-(--color-primary)" rel="noopener">{senasteKF.datum} ↗</a></li>}
        {senasteKS && <li>Kommunstyrelsen — <a href={senasteKS.url} class="underline hover:text-(--color-primary)" rel="noopener">{senasteKS.datum} ↗</a></li>}
      </ul>
      <p class="text-xs text-(--color-text-muted) mt-3">
        KF- och KS-protokollen är tolkade till beslut och voteringar (se ovan); nämndernas protokoll finns som länkar till webbdiariet.
      </p>
    </Card>

    <Card title="Nämnder" subtitle={`${nämnder.length} nämnder · ${politiker.length} förtroendevalda totalt`}>
      <ul class="flex flex-col gap-1.5 text-sm">
        {nämnder.map(([namn, o]) => (
          <li class="flex justify-between gap-3">
            <a href={`${TROMAN}/organisation/${o.id}`} class="hover:text-(--color-primary)" rel="noopener">{namn}</a>
            <span class="text-(--color-text-muted) tabular-nums">{o.antal}</span>
          </li>
        ))}
      </ul>
    </Card>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-4">Sammanträden</h2>
    <DataTable
      id="sammantraden"
      columns={[
        { key: 'datum', label: 'Datum', sort: 'date', nowrap: true, width: '120px' },
        { key: 'organ', label: 'Organ', sort: 'default' },
        { key: 'handlingar', label: 'Handlingar', sort: false, nowrap: true, width: '160px' },
      ]}
      data={mötesrader}
      pageSize={20}
    />
  </section>

  <p class="text-xs text-(--color-text-muted)">
    Källor: <a href={`${TROMAN}/`} class="underline">Mölndals stads förtroendemannaregister</a> ·
    <a href="https://www.val.se" class="underline">Valmyndigheten</a> ·
    <a href="https://www.molndal.se/kommun-och-politik/ekonomi-och-budget" class="underline">Mölndals stad, budget och årsredovisning</a> ·
    <a href="https://www.kolada.se" class="underline">Kolada</a> ·
    <a href="https://www.molndal.se/kommun-och-politik/moten-protokoll-kallelser" class="underline">Mölndals stad, möten och protokoll</a>
  </p>

  <style>
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid var(--color-border-strong);
      background: var(--color-surface);
      font-weight: 600;
      font-size: var(--font-size-label);
      padding: 4px 10px;
      border-radius: var(--radius-sm);
    }
  </style>
</Kommun>
