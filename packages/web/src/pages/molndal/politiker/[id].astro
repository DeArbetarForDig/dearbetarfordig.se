---
import PolitikerSida from '../../../components/PolitikerSida.astro'
import { getPolitiker } from '../../../data/api'

export async function getStaticPaths() {
  const politiker = await getPolitiker('molndal')
  return politiker.map((p) => ({ params: { id: p.id } }))
}
---

<!-- Arvodet räknas efter Göteborgs regler — visas inte för Mölndal -->
<PolitikerSida kommun="molndal" kommunNamn="Mölndal" id={Astro.params.id!} visaArvode={false} />
