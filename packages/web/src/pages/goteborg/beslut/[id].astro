---
import BeslutSida from '../../../components/BeslutSida.astro'
import { getAllBeslut } from '../../../data/api'

export async function getStaticPaths() {
  const allBeslut = await getAllBeslut()
  return allBeslut.map((b) => ({ params: { id: b.id }, props: { summary: b } }))
}

const { summary } = Astro.props
---

<BeslutSida
  kommun="goteborg"
  kommunNamn="Göteborg"
  id={Astro.params.id!}
  summary={summary}
  politikerUrl={(id) => `/goteborg/politiker/${id}`}
/>
