---
import MoteSida from '../../../../components/MoteSida.astro'
import { getMöten } from '../../../../data/api'

export async function getStaticPaths() {
  const möten = await getMöten()
  return möten
    .filter((m: any) => m.label?.includes('KF'))
    .map((m) => ({ params: { datum: m.datum } }))
}

const { datum } = Astro.params
---

<MoteSida kommun="goteborg" kommunNamn="Göteborg" datum={datum!} politikerUrl={(id) => `/goteborg/politiker/${id}`} />
