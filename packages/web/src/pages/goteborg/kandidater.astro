---
import Card from '../../../../ui/src/components/core/Card.astro'
import EmptyState from '../../../../ui/src/components/core/EmptyState.astro'
import PartyTag from '../../../../ui/src/components/core/PartyTag.astro'
import Table from '../../../../ui/src/components/core/Table.astro'
import { type Kandidat, getKandidater } from '../../data/api'
import Kommun from '../../layouts/Kommun.astro'

const kandidater = await getKandidater()
const antalLänkade = kandidater.filter((k) => k.politikerId).length

const grupper = new Map<string, Kandidat[]>()
for (const k of kandidater) {
  const lista = grupper.get(k.parti) || []
  lista.push(k)
  grupper.set(k.parti, lista)
}
const partiOrdning = [...grupper.entries()].sort((a, b) => b[1].length - a[1].length)
const partier = partiOrdning.map(([p]) => p)
---

<Kommun title="Kandidater till kommunfullmäktige — Göteborg" breadcrumbs={[{ label: 'Göteborg', href: '/goteborg' }, { label: 'Kandidater' }]}>
  <h1 class="text-[2rem] font-bold mb-2">Kandidater till kommunfullmäktige</h1>
  <p class="text-sm text-(--color-text-muted) mb-6">
    Val 2026 (13 september) · {kandidater.length} kandidater, {antalLänkade} redan sittande ledamöter i KF ·
    Källa: <a href="https://www.val.se" class="underline hover:text-(--color-primary)">Valmyndigheten</a>, uppdateras varje timme fram till valet
  </p>

  {kandidater.length === 0 ? (
    <EmptyState icon="users" title="Inga kandidater hämtade ännu" description="Kör pnpm scrape:kandidater för att hämta rådata från Valmyndigheten." />
  ) : (
    <>
      <div id="filter-bar" class="flex flex-wrap gap-4 items-center mb-6">
        <div class="flex items-center gap-2 bg-(--color-surface) border border-(--color-border) rounded-[--radius-sm] px-3 py-1.5 flex-1 min-w-[220px]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-(--color-text-muted) shrink-0"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="search-input" type="text" placeholder="Sök kandidat…" class="border-none outline-none bg-transparent text-(--color-text) font-sans text-base w-full" />
        </div>
        <div class="flex gap-1.5 flex-wrap">
          <button data-parti="alla" class="chip active">Alla</button>
          {partier.map(p => (
            <button data-parti={p} class="chip">
              <span class="w-2.5 h-2.5 rounded-sm shrink-0 bg-(--parti-color)" style={`--parti-color:var(--parti-${p.toLowerCase()}, var(--parti-ovriga))`} />
              {p}
            </button>
          ))}
        </div>
      </div>

      <div id="grupper" class="flex flex-col gap-6">
        {partiOrdning.map(([parti, lista]) => (
          <div class="parti-group" data-parti={parti}>
            <Card>
              <div class="flex items-center justify-between mb-3">
                <PartyTag parti={parti} full size="md" />
                <span class="text-xs text-(--color-text-subtle)">
                  {lista.length} kandidater{lista.filter(k => k.politikerId).length > 0 && ` · ${lista.filter(k => k.politikerId).length} sittande`}
                </span>
              </div>
              <Table
                headers={['#', 'Namn', 'Ålder', 'Status']}
                alignRight={[0, 2]}
                rows={lista.map(k => [
                  k.listplats ?? '–',
                  k.politikerId ? { text: k.namn, href: `/goteborg/politiker/${k.politikerId}` } : k.namn,
                  k.ålder ?? '–',
                  { text: k.politikerId ? 'Sittande ledamot' : 'Ny kandidat', color: k.politikerId ? 'var(--color-positive)' : 'var(--color-neutral)' },
                ])}
                variant="compact"
              />
            </Card>
          </div>
        ))}
      </div>
      <p id="empty-filter" class="hidden text-sm text-(--color-text-muted) text-center py-8">Inga kandidater matchar filtret.</p>
    </>
  )}

  <style>
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid var(--color-border-strong);
      background: var(--color-surface);
      color: var(--color-text);
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: var(--font-size-label);
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: background var(--transition), color var(--transition);
    }
    .chip.active {
      background: var(--color-text);
      color: var(--color-bg);
      border-color: var(--color-text);
    }
  </style>

  <script is:inline>
    const input = document.getElementById('search-input')
    const partiChips = document.querySelectorAll('.chip')
    const groups = document.querySelectorAll('.parti-group')
    const emptyMsg = document.getElementById('empty-filter')
    let activeParti = 'alla'

    function filter() {
      const q = (input?.value || '').toLowerCase()
      let anyVisible = false
      groups.forEach(group => {
        const parti = group.dataset.parti
        const matchParti = activeParti === 'alla' || parti === activeParti
        const rows = group.querySelectorAll('tbody tr')
        let visibleRows = 0
        rows.forEach(row => {
          const namn = (row.children[1]?.textContent || '').toLowerCase()
          const show = matchParti && namn.includes(q)
          row.classList.toggle('hidden', !show)
          if (show) visibleRows++
        })
        const show = matchParti && visibleRows > 0
        group.classList.toggle('hidden', !show)
        if (show) anyVisible = true
      })
      emptyMsg?.classList.toggle('hidden', anyVisible)
    }

    input?.addEventListener('input', filter)
    partiChips.forEach(chip => {
      chip.addEventListener('click', () => {
        partiChips.forEach(c => c.classList.remove('active'))
        chip.classList.add('active')
        activeParti = chip.dataset.parti
        filter()
      })
    })
  </script>
</Kommun>
