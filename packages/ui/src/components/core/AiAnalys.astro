---
/**
 * AI-analys av ett beslut, byggd för att skummas.
 *
 * Ordningen är avsiktlig: en invånare som lägger tjugo sekunder på fliken ska
 * ändå gå därifrån med det väsentliga. Först vem som skrivit texten, sedan en
 * mening om vad beslutet innebär, sedan nyckelpunkterna med färg, sedan för och
 * emot sida vid sida. Hela analysen ligger hopfälld under — den är källan till
 * allt ovanför, inte det man måste ta sig igenom först.
 *
 * Märkningen står överst och kan inte fällas ihop: den som läser ska veta exakt
 * vad hen läser och kunna gå till källan själv.
 */
import { renderaMarkdown } from '@daf/shared'
import Accordion from './Accordion.astro'
import Card from './Card.astro'
import Icon from './Icon.astro'

interface Props {
  analys: {
    modell: string
    genererad: string
    granskad_av: string | null
    granskad_datum: string | null
    riktning: 'positiv' | 'negativ' | 'blandad' | 'oklar'
    confidence: 'low' | 'medium' | 'high'
    sammanfattning: string
    nyckelpunkter: { ton: 'varning' | 'styrka' | 'fakta'; text: string }[]
    talar_för: { text: string; källa: string }[]
    talar_emot: { text: string; källa: string }[]
    analys_md: string
    källor: { typ: 'internt' | 'webb'; ref: string; vad: string }[]
  }
}

const { analys } = Astro.props

const TON = {
  varning: { ikon: 'alert-triangle', etikett: 'Se upp med' },
  styrka: { ikon: 'check-circle', etikett: 'Håller' },
  fakta: { ikon: 'info', etikett: 'Att veta' },
} as const

const RIKTNING = {
  positiv: 'Bedöms få positiv effekt',
  negativ: 'Bedöms få negativ effekt',
  blandad: 'Bedöms få blandad effekt',
  oklar: 'Effekten går inte att bedöma',
} as const

const SÄKERHET = { low: 'Låg', medium: 'Medelhög', high: 'Hög' } as const

const brödtext = renderaMarkdown(analys.analys_md)
const interna = analys.källor.filter((k) => k.typ === 'internt')
const webb = analys.källor.filter((k) => k.typ === 'webb')
---

<div class="daf-ai space-y-4">
  <p class="daf-ai__markning">
    <Icon name="bot" size={16} />
    <span>
      <strong>Skriven av en AI-modell ({analys.modell}), inte av en människa.</strong>
      Bygger på stadens egna handlingar och öppna källor — varje påstående har en källa
      längst ned som du kan gå till själv.
      {
        analys.granskad_av ? (
          <> Granskad av {analys.granskad_av} den {analys.granskad_datum}.</>
        ) : (
          <> <strong>Ännu inte granskad av en människa.</strong></>
        )
      }
    </span>
  </p>

  <Card title="Det viktigaste" subtitle={`${RIKTNING[analys.riktning]} · Säkerhet i bedömningen: ${SÄKERHET[analys.confidence]}`}>
    <p class="daf-ai__sammanfattning">{analys.sammanfattning}</p>
    <ul class="daf-ai__punkter">
      {analys.nyckelpunkter.map((p) => (
        <li class:list={['daf-ai__punkt', `daf-ai__punkt--${p.ton}`]}>
          <Icon name={TON[p.ton].ikon} size={18} />
          <span><b>{TON[p.ton].etikett}:</b> {p.text}</span>
        </li>
      ))}
    </ul>
  </Card>

  {(analys.talar_för.length > 0 || analys.talar_emot.length > 0) && (
    <div class="daf-ai__vagskal">
      {analys.talar_för.length > 0 && (
        <Card title="Talar för beslutet" class="daf-ai__sida daf-ai__sida--for">
          <ul class="daf-ai__skal">
            {analys.talar_för.map((p) => (
              <li>{p.text} <span class="daf-ai__kalla">{p.källa}</span></li>
            ))}
          </ul>
        </Card>
      )}
      {analys.talar_emot.length > 0 && (
        <Card title="Talar emot beslutet" class="daf-ai__sida daf-ai__sida--emot">
          <ul class="daf-ai__skal">
            {analys.talar_emot.map((p) => (
              <li>{p.text} <span class="daf-ai__kalla">{p.källa}</span></li>
            ))}
          </ul>
        </Card>
      )}
    </div>
  )}

  <Card title="Hela analysen" subtitle={`Skriven ${analys.genererad} — underlaget till allt ovanför`}>
    <Accordion summary="Läs hela analysen">
      <div class="daf-ai__brodtext" set:html={brödtext} />
    </Accordion>
  </Card>

  <Card title={`Källor (${analys.källor.length})`}>
    {interna.length > 0 && (
      <>
        <h4 class="daf-ai__kallrubrik">Stadens egna handlingar</h4>
        <ul class="daf-ai__kallor">
          {interna.map((k) => (
            <li><code>{k.ref}</code> — {k.vad}</li>
          ))}
        </ul>
      </>
    )}
    {webb.length > 0 && (
      <>
        <h4 class="daf-ai__kallrubrik">Externa källor</h4>
        <ul class="daf-ai__kallor">
          {webb.map((k) => (
            <li>
              <a href={k.ref} target="_blank" rel="noopener noreferrer">{k.ref}</a> — {k.vad}
            </li>
          ))}
        </ul>
      </>
    )}
  </Card>
</div>

<style>
  .daf-ai__markning {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.875rem 1rem;
    font-size: var(--font-size-small);
    line-height: 1.6;
    color: var(--color-text-muted);
    background: var(--color-surface-sunken);
    border-radius: var(--radius-sm);
  }

  .daf-ai__markning strong {
    color: var(--color-text);
  }

  .daf-ai__sammanfattning {
    margin-bottom: 1rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .daf-ai__punkter {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  /* Färgen bär bara samma budskap som ikonen och etiketten ("Se upp med",
     "Håller", "Att veta") — den som inte uppfattar färg tappar ingen
     information. */
  .daf-ai__punkt {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
    padding: 0.75rem 0.875rem;
    line-height: 1.5;
    background: var(--color-surface-sunken);
    border-left: 3px solid var(--ton);
    border-radius: var(--radius-sm);
  }

  .daf-ai__punkt :global(svg) {
    flex-shrink: 0;
    color: var(--ton);
  }

  .daf-ai__punkt--varning {
    --ton: var(--color-warning);
  }

  .daf-ai__punkt--styrka {
    --ton: var(--color-positive);
  }

  .daf-ai__punkt--fakta {
    --ton: var(--color-info);
  }

  .daf-ai__vagskal {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  /* Kortet står kvar som på resten av sidan; färgen läggs som en kant ovanpå,
     inte som en egen behållare. */
  .daf-ai__sida {
    border-top: 3px solid var(--ton);
  }

  .daf-ai__sida--for {
    --ton: var(--color-positive);
  }

  .daf-ai__sida--emot {
    --ton: var(--color-negative);
  }

  .daf-ai__skal {
    margin: 0;
    padding-left: 1.125rem;
    list-style: disc;
  }

  .daf-ai__skal li {
    margin-bottom: 0.625rem;
    line-height: 1.5;
  }

  .daf-ai__kalla {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    overflow-wrap: anywhere;
  }

  /* Brödtexten kommer från renderaMarkdown() — styla via elementväljare, den
     har inga klasser att haka på. */
  .daf-ai__brodtext :global(h3) {
    margin: 1.75rem 0 0.75rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .daf-ai__brodtext :global(h3):first-child {
    margin-top: 0;
  }

  .daf-ai__brodtext :global(h4) {
    margin: 1.5rem 0 0.5rem;
    font-weight: 600;
  }

  .daf-ai__brodtext :global(p),
  .daf-ai__brodtext :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.7;
  }

  .daf-ai__brodtext :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .daf-ai__brodtext :global(code),
  .daf-ai__kallor code {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .daf-ai__brodtext :global(a),
  .daf-ai__kallor a {
    color: var(--color-primary);
    text-decoration: underline;
    /* Modellgenererade URL:er kan vara långa — bryt hellre än att spränga
       layouten på mobil. */
    overflow-wrap: anywhere;
  }

  .daf-ai__kallrubrik {
    margin: 1rem 0 0.5rem;
    font-size: var(--font-size-small);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .daf-ai__kallrubrik:first-child {
    margin-top: 0;
  }

  .daf-ai__kallor {
    padding-left: 1.25rem;
    font-size: var(--font-size-small);
    line-height: 1.6;
    list-style: disc;
  }
</style>
