# Caddy reverse proxy — automatic HTTPS (Let's Encrypt) for the API.
# The root domain (static Astro site) is served separately by GitHub Pages,
# not this VPS — see docs/HOSTING.md for the custom-domain/DNS setup.

api.dearbetarfordig.se {
	reverse_proxy api:3000
}

# Extra sites configured on the server itself (/etc/caddy/sites/*.caddy, mounted by a server-only
# docker-compose.override.yml). No match is fine: Caddy skips an empty glob.
import /etc/caddy/sites/*.caddy
